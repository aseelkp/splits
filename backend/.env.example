# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Local dev default (no Supabase needed): a SQLite file.
# DATABASE_URL=sqlite:///./dev.db

# Production: Supabase -> Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543). Paste it as-is; the app adds the psycopg driver.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

TIMEZONE=Asia/Kolkata

# Web login. Pick any password. Make SESSION_SECRET long and random, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If either is empty, login is disabled (the app fails closed).
APP_PASSWORD=
SESSION_SECRET=
# Cookie is only sent over https. localhost works in Chrome/Firefox; set false only for plain-http testing.
COOKIE_SECURE=true

# MCP endpoint for Claude: https://<your-domain>/mcp/<MCP_SECRET>. The URL is the only protection,
# so use 16+ random characters (shorter or empty = endpoint disabled), e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_SECRET=
